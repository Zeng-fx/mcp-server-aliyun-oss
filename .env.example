# ==============================================================================
# 阿里云 OSS MCP 服务端环境变量配置文件
# 使用说明：将本文件复制一份重命名为 .env，并填入你自己的实际配置
# ==============================================================================

# 【必填】阿里云访问密钥 AccessKey ID
# 获取途径：登录阿里云控制台 -> 鼠标悬停右上角头像 -> AccessKey 管理
# 注：若使用 oss_replace_image 自动刷新 CDN 缓存功能，该 AccessKey 还需拥有 CDN 刷新权限（例如 RAM 策略中的 cdn:DescribeRefreshQuota 和 cdn:RefreshObjectCaches，或 AliyunCDNFullAccess）
OSS_ACCESS_KEY_ID=your_access_key_id

# 【必填】阿里云访问密钥 AccessKey Secret
OSS_ACCESS_KEY_SECRET=your_access_key_secret

# 【必填】OSS 存储空间（Bucket）名称
OSS_BUCKET=your_bucket_name

# 【必填】OSS 数据中心地域标识（例如: oss-cn-hangzhou、oss-cn-beijing、oss-cn-shanghai）
OSS_REGION=oss-cn-hangzhou

# 【选填】自定义绑定的 CDN / 项目加速业务域名（所有工具返回的 URL 都会统一自动替换为该域名）
# 示例: https://musetopia-us.museselect.com
# 也可以配置别名 OSS_REPLACE_DOMAIN
OSS_CUSTOM_DOMAIN=https://musetopia-us.museselect.com

# 【选填】默认上传目录前缀（在上传工具未指定 targetDir 时使用该默认路径）
# 例如: prototypes/
OSS_DEFAULT_PREFIX=prototypes/

# 【选填】自定义访问 Endpoint（通常使用默认的 OSS_REGION 即可，内网或专有云场景下才需要填写）
OSS_ENDPOINT=

# 【选填】受保护的目录黑名单（默认空，不设业务前缀限制；多个用逗号隔开，匹配前缀严禁删除）
# 例如: prod/,production/,release/,content/
OSS_PROTECTED_PREFIXES=

# 【选填】允许删除的目录白名单（默认空，不设白名单限制；若配置，则【仅允许】删除这些前缀下的内容）
# 例如: prototypes/,temp/,test/
OSS_ALLOW_DELETE_PREFIXES=
